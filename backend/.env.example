LLM_PROVIDER=anthropic            # or openai, gemini, etc.
LLM_API_KEY=your_key_here
LLM_MODEL=your_model_name
WEATHER_API_KEY=                  # leave empty if using Open-Meteo
ROUTING_API_KEY=                  # leave empty if using public OSRM
ALLOWED_ORIGINS=http://localhost:5173
MOCK_MODE=false                   # set true to force deterministic demo outputs
