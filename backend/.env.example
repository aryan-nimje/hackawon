LLM_PROVIDER=openai            # or openai, gemini, etc.
LLM_API_KEY=
LLM_MODEL=
WEATHER_API_KEY=                  # leave empty if using Open-Meteo
ROUTING_API_KEY=                  # leave empty if using public OSRM
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ALLOWED_ORIGIN_REGEX=http://192\.168\.\d+\.\d+:517\d   # other devices on your network
MOCK_MODE=false                   # set true to force deterministic demo outputs
DEFAULT_CITY=Pune                 # city served by /layers and used by weather, detection and routing
LIVE_OSM=true                     # let GET /layers?city=<other> fetch uncached cities from OpenStreetMap
SIMULATE_WEATHER=false            # true = always inject the simulated heavy-rain alert (reliable demos)

# --- PostgreSQL: ONE database ---
# The same database the citizen app writes its `reports` table to. The backend reads `reports` from it (dashboard feed,
# detection, live updates) and keeps its own tables beside it (runs, incidents, report_submissions). It never writes to `reports`.
# On Render use the *External* Database URL and keep ?sslmode=require. Empty = in-memory only, no real reports.
DATABASE_URL=                     # postgresql://user:password@host:5432/dbname?sslmode=require
CITIZEN_POLL_SECONDS=15           # how often new reports are announced to the dashboard / planned into the active run (0 = off)
CITIZEN_REPORTS_WINDOW_HOURS=72   # only reports newer than this are read
CITIZEN_REPORTS_LIMIT=200
SEED_REPORTS=false                # true replays the shipped Pune demo reports (data/reports.json) and 3 "[SIMULATED]" news items next to real ones
DB_RESYNC_SECONDS=15              # memory is re-checked against the database this often, so rows deleted there disappear from the dashboard (0 = off)
# Only if `reports` lives in a DIFFERENT database than DATABASE_URL (normally leave empty):
# CITIZEN_DATABASE_URL=
# CITIZEN_REPORTS_TABLE=reports
# CITIZEN_COLUMN_MAP={"text":"description"}

# --- External evidence: SACHET (India's national CAP alert hub, official alerts) ---
SACHET_ENABLED=true
SACHET_FEED_URLS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml   # comma-separated; state feeds: .../rss/rss_maharashtra.xml
SACHET_POLL_SECONDS=900           # 0 = never poll, only POST /signals/sachet/refresh
SACHET_TIMEOUT_SECONDS=15
SACHET_MAX_ITEMS=40               # newest N feed items per feed per refresh
SACHET_MAX_BYTES=1000000          # size cap per downloaded document
SACHET_DEFAULT_TTL_HOURS=24       # lifetime of alerts that carry no <expires>
SACHET_INGEST_NON_ACTUAL=false    # true also keeps Test / Exercise / Draft alerts
SIGNALS_RETENTION_HOURS=72        # expired signals are pruned after this
# Scoring constants (all optional; defaults in services/signals/scoring.py, effective values at GET /signals/scoring):
# SIGNAL_TRUST_SACHET=0.9
# SIGNAL_TRUST_OPEN_METEO=0.7       # ceiling for weather: model output, no issuing authority
# SIGNAL_TRUST_GDELT=0.5            # ceiling for news: unverified headlines
# SIGNAL_SEVERITY_WEIGHTS={"extreme":1,"severe":0.8,"moderate":0.5,"minor":0.25,"unknown":0.3}
# SIGNAL_CERTAINTY_WEIGHTS={"observed":1,"likely":0.8,"possible":0.5,"unlikely":0.2,"unknown":0.4}
# SIGNAL_URGENCY_WEIGHTS={"immediate":1,"expected":0.7,"future":0.4,"past":0.1,"unknown":0.4}
# SIGNAL_COMPONENT_WEIGHTS={"severity":0.5,"certainty":0.3,"urgency":0.2}
# SIGNAL_FRESHNESS_HALF_LIFE_HOURS=12
# SIGNAL_FRESHNESS_FLOOR=0.1

# --- External evidence: Open-Meteo (rain / river flood / wind / thunderstorm / heat; free, no key; non-commercial use) ---
# A signal exists only while a threshold is crossed, so calm weather leaves nothing in the store.
OPEN_METEO_ENABLED=true
OPEN_METEO_POLL_SECONDS=1800      # 0 = never poll, only POST /signals/open-meteo/refresh
OPEN_METEO_CITIES=                # comma-separated CACHED cities (data/layers_<slug>.json); empty = DEFAULT_CITY
OPEN_METEO_TTL_HOURS=3            # a signal lives this long after each refresh; a clear forecast expires it right away
OPEN_METEO_FLOOD_ENABLED=true     # GloFAS river discharge (flood-api.open-meteo.com)
OPEN_METEO_FLOOD_PAST_DAYS=30     # baseline window: the median discharge of these days
OPEN_METEO_FLOOD_HORIZON_DAYS=5
OPEN_METEO_FLOOD_MIN_DISCHARGE=5  # m3/s: smaller rivers are ignored
OPEN_METEO_CERTAIN_WITHIN_HOURS=24  # peaks further out are "possible", nearer ones "likely" (never "observed")
OPEN_METEO_TIMEOUT_SECONDS=15
OPEN_METEO_MAX_BYTES=2000000
# Threshold ladders (JSON; partial overrides allowed; a bad value is logged and ignored). Effective values: GET /signals/scoring
# OPEN_METEO_RAIN_24H_MM={"minor":35.5,"moderate":64.5,"severe":115.6,"extreme":204.5}
# OPEN_METEO_RAIN_1H_MM={"minor":7.6,"moderate":15,"severe":30,"extreme":50}
# OPEN_METEO_FLOOD_RATIOS={"minor":2,"moderate":3,"severe":5,"extreme":8}     # peak discharge / recent median
# OPEN_METEO_WIND_GUST_KMH={"minor":50,"moderate":62,"severe":89,"extreme":118}
# OPEN_METEO_HEAT_C={"minor":40,"moderate":43,"severe":45,"extreme":47}

# --- External evidence: GDELT (hazard news per city; headlines only, article pages are never fetched) ---
GDELT_ENABLED=true
GDELT_POLL_SECONDS=1800           # 0 = never poll, only POST /signals/gdelt/refresh
GDELT_CITIES=                     # comma-separated CACHED cities; empty = DEFAULT_CITY
GDELT_QUERY_TERMS=flood,flooded,flooding,waterlogging,heavy rain,cloudburst,landslide,dam release,cyclone
GDELT_TIMESPAN=24h                # 6h, 24h, 3d ...
GDELT_MAX_RECORDS=50              # 1..250 per city per refresh
GDELT_SOURCE_LANG=english         # empty = any language
GDELT_TTL_HOURS=24                # an article counts as evidence this long after GDELT saw it
GDELT_CORROBORATION_DOMAINS=3     # this many different outlets raise certainty one rung
GDELT_MIN_INTERVAL_SECONDS=5.5    # GDELT allows about one request per 5 seconds
GDELT_TIMEOUT_SECONDS=20
GDELT_MAX_BYTES=2000000

# --- Verification: evidence support + crowd corroboration (all optional) ---
# One JSON object overriding any number from CorroborationConfig (services/corroboration.py); invalid entries are ignored.
# max_credibility can be lowered but never raised above 0.95. Effective values: GET /signals/scoring -> "corroboration".
# CORROBORATION_CONFIG={"evidence_boost_broad":0.05,"evidence_boost_local":0.12,"crowd_boost_tiers":[[2,0.10],[3,0.15],[5,0.20],[10,0.25],[25,0.35]]}
